import javafx.application.Application;
import javafx.geometry.Insets;
import javafx.scene.Scene;
import javafx.scene.control.Button;
import javafx.scene.control.TextField;
import javafx.scene.layout.HBox;
import javafx.scene.layout.VBox;
import javafx.scene.web.WebEngine;
import javafx.scene.web.WebHistory;
import javafx.scene.web.WebView;
import javafx.stage.Stage;

public class ProjetoMiniWebBrowser extends Application {

	@Override
	public void start(Stage palco) {
		WebView navegador = new WebView();
		WebEngine motor = navegador.getEngine();

		Button botaoVoltar = new Button("< Voltar");
		Button botaoAvancar = new Button("> Avançar");
		Button botaoRecarregar = new Button("Recarregar");

		TextField campoUrl = new TextField();
		campoUrl.setPromptText("Digite a URL e pressione Enter");
		campoUrl.setPrefWidth(400);
		campoUrl.setOnAction(evento -> motor.load(formataUrl(campoUrl.getText()))); // carrega uma página da web quando o usuário pressiona enter

		WebHistory historico = motor.getHistory(); 

		botaoVoltar.setOnAction(e -> {
			if (historico.getCurrentIndex() > 0) {
				historico.go(-1); // volta 1 passo
			} 
		});

		botaoAvancar.setOnAction(e -> {
			if (historico.getCurrentIndex() < historico.getEntries().size() -1) {
				historico.go(1); // avança 1 passo
			}
		});

		botaoRecarregar.setOnAction(e -> motor.reload());

		HBox barraNavegacao = new HBox(10, botaoVoltar, botaoAvancar, botaoRecarregar, campoUrl);
		barraNavegacao.setPadding(new Insets(10));

		VBox vBox = new VBox(barraNavegacao, navegador);

		Scene cena = new Scene(vBox, 800, 600);
		palco.setTitle("Meu Browser Java Básico");
		palco.setScene(cena);
		palco.show();
	}

	public String formataUrl (String url) {
		if (!url.startsWith("http://") && !url.startsWith("https://")) {
			url = "https://" + url;
		}
		return url;
	}

	public static void main(String[] args) {
		launch(args);
	}
}
